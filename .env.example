# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database / Cache ----
DATABASE_URL=postgresql://estateflow:estateflow@localhost:5432/estateflow?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me-dev-access-secret
JWT_REFRESH_SECRET=change-me-dev-refresh-secret
# 32-byte key, base64 encoded, used for AES-256-GCM encryption of provider creds
ENCRYPTION_KEY=0000000000000000000000000000000000000000000=

# ---- LLM ----
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
STT_PROVIDER=gemini

# ---- Media (Cloudflare R2 / S3) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---- Observability ----
SENTRY_DSN=

# ---- Telephony (optional) ----
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=

# ---- Google Calendar (optional) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
