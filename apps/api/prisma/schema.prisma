// EstateFlow Prisma schema.
// Task 1 established the baseline (Tenant). Task 2 adds Team, User and the
// invite flow. Every tenant-scoped table carries tenantId + timestamps and is
// protected by Postgres Row-Level Security (see prisma/rls/*.sql, applied by a
// migration). Later tasks (3 = contacts/leads/pipeline, 4+ = messages, etc.)
// extend this schema.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pgcrypto]
}

enum Plan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

// RBAC roles (PRD §3). Mirrors packages/shared Role so the two stay in lockstep.
enum Role {
  OWNER
  SALES_MANAGER
  TELE_CALLER
  FIELD_AGENT
  MARKETING
  POST_SALES
  CHANNEL_PARTNER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Lead score tiers (FR-10).
enum Tier {
  HOT
  WARM
  COLD
}

// Lead sources (PRD §4.1 / §7). Mirrors packages/shared LeadSource.
enum LeadSource {
  WHATSAPP
  META_LEAD_ADS
  NINETY_NINE_ACRES
  MAGICBRICKS
  HOUSING
  WEBSITE
  REFERRAL
  MANUAL
}

// Timeline activity types (PRD §7 activities table).
enum ActivityType {
  NOTE
  STAGE_CHANGE
  ASSIGNMENT
  CALL
  VISIT
  ENQUIRY
  MESSAGE
  SCORE_CHANGE
}

// WhatsApp BSP type (mirrors packages/shared WhatsAppProviderType).
enum WhatsAppProviderType {
  AISENSY
  WATI
  META_CLOUD
  MOCK
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  text
  image
  audio
  video
  document
  interactive
  template
}

enum MessageStatus {
  received
  queued
  sent
  delivered
  read
  failed
}

enum MessageSentBy {
  ai
  user
  system
}

model Tenant {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  plan           Plan     @default(FREE)
  // Free-form tenant settings, AI config and scoring weights (PRD §7).
  settings       Json     @default("{}")
  aiConfig       Json     @default("{}")
  scoringWeights Json     @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  teams          Team[]
  invites        Invite[]
  contacts            Contact[]
  leads               Lead[]
  pipelineStages      PipelineStage[]
  activities          Activity[]
  providerCredentials ProviderCredential[]
  messages            Message[]
  templates           Template[]
  llmUsage            LlmUsage[]
  scoreEvents         ScoreEvent[]
  routingRules        RoutingRule[]
  notifications       Notification[]
  projects            Project[]
  units               Unit[]
  mediaAssets         MediaAsset[]
  // Round-robin cursor so routing rotates fairly across invocations.
  routingCursor       Int                  @default(0)

  @@map("tenants")
}

model Team {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("teams")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  email          String
  name           String
  // Argon2id hash. Null until an invited user accepts and sets a password.
  passwordHash   String?
  role           Role
  teamId         String?  @db.Uuid
  // Language skills for routing (FR-11). ISO-ish codes, e.g. ["en","hi","mr"].
  languages      String[] @default([])
  maxActiveLeads Int      @default(100)
  isActive       Boolean  @default(true)
  // Bumped on logout / password change to invalidate outstanding refresh tokens.
  tokenVersion   Int      @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  team   Team?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("users")
}

model Invite {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  email     String
  name      String
  role      Role
  teamId    String?      @db.Uuid
  languages String[]     @default([])
  // SHA-256 of the opaque invite token; the raw token is only sent to the invitee.
  tokenHash String       @unique
  status    InviteStatus @default(PENDING)
  invitedBy String?      @db.Uuid
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("invites")
}


// A person who enquired. Dedup key is (tenantId, phoneE164) — FR-3.
model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  phoneE164  String
  name       String?
  language   String?
  optedIn    Boolean   @default(true)
  optedOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, phoneE164])
  @@index([tenantId])
  @@map("contacts")
}

// Per-tenant pipeline stage (FR-20). order defines kanban column position;
// isTerminal marks Lost/Booked style end states.
model PipelineStage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  order      Int
  isTerminal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("pipeline_stages")
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @db.Uuid
  contactId      String     @db.Uuid
  source         LeadSource @default(MANUAL)
  // Stage stored by name for simplicity + tenant-customizable ordering; the
  // PipelineStage table is the source of truth for columns/order.
  stage          String     @default("New")
  tier           Tier       @default(COLD)
  score          Int        @default(0)
  assignedTo     String?    @db.Uuid
  // Whether the AI agent is handling this conversation (Task 10). When a human
  // takes over this flips to false and the AI stays silent.
  aiActive       Boolean    @default(true)
  // Qualification JSON extracted by the LLM (Task 6). Empty until then.
  qualification  Json       @default("{}")
  lostReason     String?
  lastInboundAt  DateTime?
  nextFollowupAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities  Activity[]
  messages    Message[]
  scoreEvents ScoreEvent[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, assignedTo])
  @@index([tenantId, tier])
  @@map("leads")
}

// Append-only timeline event for a lead (PRD §7 activities table).
model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  leadId    String       @db.Uuid
  type      ActivityType
  // Structured payload (e.g. note body, {from,to} for stage change).
  payload   Json         @default("{}")
  userId    String?      @db.Uuid
  createdAt DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@map("activities")
}


// Per-tenant WhatsApp BSP credentials (PRD §9). The config (apiKey, baseUrl,
// webhookSecret, …) is AES-256-GCM encrypted at rest; only encryptedConfig is
// stored. One active credential per tenant per provider type.
model ProviderCredential {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  type            WhatsAppProviderType
  // Opaque per-tenant key used in the webhook URL (/webhooks/whatsapp/:provider/:tenantKey)
  // so inbound requests resolve to a tenant without exposing the tenant id.
  tenantKey       String               @unique
  encryptedConfig String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("provider_credentials")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  leadId            String           @db.Uuid
  direction         MessageDirection
  type              MessageType      @default(text)
  body              String?
  mediaUrl          String?
  transcript        String?
  // Unique per tenant so a redelivered webhook is idempotent (FR §4.4 / Task 4).
  providerMessageId String?
  status            MessageStatus    @default(received)
  sentBy            MessageSentBy    @default(system)
  userId            String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerMessageId])
  @@index([tenantId])
  @@index([tenantId, leadId])
  @@map("messages")
}


enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
}

// WhatsApp message templates, synced from the provider (PRD §4.9 / FR-21).
model Template {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  name       String
  language   String         @default("en")
  category   String?
  body       String
  // Number of positional {{n}} params in the body.
  paramCount Int            @default(0)
  status     TemplateStatus @default(APPROVED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, language])
  @@index([tenantId])
  @@map("templates")
}


// Per-tenant LLM token + cost accounting (PRD §5 observability / §7 llm_usage).
model LlmUsage {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  leadId           String?  @db.Uuid
  model            String
  operation        String   // 'extract' | 'chat' | ...
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costMicroUsd     Int      @default(0)
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("llm_usage")
}


// Score history: every change with its explainable reasons (PRD §4.3 / FR-10).
model ScoreEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  leadId    String   @db.Uuid
  oldScore  Int
  newScore  Int
  reasons   Json     @default("[]")
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, leadId])
  @@map("score_events")
}


// Routing rule (PRD §4.4 / FR-11). conditions/action are JSON validated by the
// shared zod schemas; priority ascending = higher precedence.
model RoutingRule {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  priority   Int      @default(100)
  conditions Json     @default("{}")
  action     Json     @default("{}")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, priority])
  @@map("routing_rules")
}

enum NotificationType {
  LEAD_ASSIGNED
  SLA_ESCALATION
  HOT_LEAD
  SYSTEM
}

// In-app notifications (PRD §4.11 / FR-27).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  leadId    String?          @db.Uuid
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId, readAt])
  @@map("notifications")
}


// Property project (building/society) — PRD §4.6 / FR-16.
model Project {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  location    String
  description String?
  possession  DateTime?
  amenities   String[] @default([])
  mapPin      String?  // "lat,lng"
  brochureUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units  Unit[]

  @@index([tenantId])
  @@map("projects")
}

// A sellable unit. The pgvector `embedding` column is added via raw SQL in the
// migration (Prisma lacks a native vector type) and queried with raw SQL for
// matching (PRD §4.6 / FR-17).
model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  projectId   String   @db.Uuid
  name        String
  bhk         Int
  carpetArea  Int?     // sq ft
  priceMin    Int      // INR
  priceMax    Int
  facing      String?
  floor       Int?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, bhk])
  @@map("units")
}

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  projectId String?  @db.Uuid
  unitId    String?  @db.Uuid
  kind      String   // 'image' | 'brochure' | 'floorplan'
  url       String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("media_assets")
}
